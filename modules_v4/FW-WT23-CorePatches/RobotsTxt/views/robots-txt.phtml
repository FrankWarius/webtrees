<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Http\Middleware\RobotsTxtBlocker;

/**
 * Ersetzt resources/views/robots-txt.phtml.
 *
 * @var string           $base_path
 * @var string           $base_url
 * @var string           $sitemap_url
 * @var iterable<string> $trees
 */

// Die Regeln stammen aus der Middleware, damit ausgelieferte und
// durchgesetzte Fassung nicht auseinanderlaufen koennen. Fehlt der
// Kernpatch RobotsTxtBlocker, greifen die bisherigen festen Listen.
if (class_exists(RobotsTxtBlocker::class)) {
    $blocked_paths      = RobotsTxtBlocker::DISALLOWED_PATHS;
    $blocked_tree_paths = RobotsTxtBlocker::DISALLOWED_TREE_PATHS;
} else {
    $blocked_paths = [
        'admin',
        'manager',
        'moderator',
        'editor',
        'account',
        'login',
        'family.php',
        'individual.php',
        'mediafirewall.php',
        'mediaviewer.php',
        'module.php',
        'source.php',
        'public/*.png',
        'module/statistics_chart',
        'module/tree',
    ];

    $blocked_tree_paths = [
        'ancestors',
        'anniversary-ics',
        'branches',
        'compact',
        'contact',
        'descendants',
        'family-book',
        'family-list',
        'fan-chart',
        'hourglass',
        'individual-list',
        'lifespans',
        'location-list',
        'media-download',
        'media-list',
        'media-objects',
        'media-thumbnail',
        'pedigree',
        'place-list',
        'relationships',
        'report',
        'repository-list',
        'search',
        'source-list',
        'timeline',
        '*?ajax=1',
    ];
}

?>
<?php
// Hinweis: PHP verschluckt einen Zeilenumbruch direkt hinter dem
// schliessenden PHP-Tag. Zeilen, die mit einer Ausgabe enden, haengen ihn
// deshalb selbst an.
?>
# robots.txt for <?= $base_url, "\n" ?>
<?php if ($base_path !== '') : ?>
# CAUTION!  This robots.txt needs to be copied to the root folder.
<?php endif ?>
User-agent: *
<?php foreach ($blocked_paths as $blocked_path) : ?>
Disallow: <?= $base_path ?>/<?= $blocked_path, "\n" ?>
<?php endforeach ?>
<?php foreach ($trees as $tree) : ?>

# <?= $tree ?>

<?php foreach ($blocked_tree_paths as $blocked_tree_path) : ?>
Disallow: <?= $base_path ?>/tree/<?= $tree ?>/<?= $blocked_tree_path, "\n" ?>
<?php endforeach ?>
<?php endforeach ?>

Crawl-delay: 2
<?php if ($sitemap_url !== '') : ?>
Sitemap: <?= $sitemap_url, "\n" ?>
<?php endif ?>