<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <clear />
                <rule name="HTTPS Redirect" enabled="false" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}"
                        appendQueryString="false" redirectType="Permanent" />
                </rule>
                <rule name="OSM Tiles Proxy (secured)" stopProcessing="true">
                    <match url="^((?:[abcd])\.)?cache-osm\.([a-zA-Z]+)/(\d+)/(\d+)/(\d+)\.png$" />
                    <!-- Cookie-Gate -->
                    <conditions logicalGrouping="MatchAll">
                        <!-- Cookie "OSMAccess=xxx" muss existieren -->
                        <add input="{HTTP_COOKIE}" pattern="(^|;\s*)OSMAccess=1380(;|$)" />
                    </conditions>
                    <serverVariables>
                        <set name="HTTP_USER_AGENT"
                            value="WebtreesOSMCache/1.0 (+wbt.warius.info frank@warius.de)" />
                    </serverVariables>
                    <action
                        type="Rewrite"
                        url="https://{R:1}tile.openstreetmap.{R:2}/{R:3}/{R:4}/{R:5}.png"
                        appendQueryString="false"
                        logRewrittenUrl="true" />
                </rule>
                <!-- OSM Tiles Proxy -->
                <rule name="OSM Tiles Proxy" stopProcessing="true">
                    <match url="^((?:[abcd])\.)?cache-osm\.([a-zA-Z]+)/(\d+)/(\d+)/(\d+)\.png$" />
                    <serverVariables>
                        <set name="HTTP_USER_AGENT"
                            value="WebtreesOSMCache/1.0 (+wbt.warius.info frank@warius.de)" />
                    </serverVariables>
                    <action type="Rewrite"
                        url="https://{R:1}tile.openstreetmap.{R:2}/{R:3}/{R:4}/{R:5}.png"
                        appendQueryString="false" logRewrittenUrl="true" />
                    <conditions>
                        <add input="{HTTP_REFERER}" pattern="^https://wbt.warius.info" />
                    </conditions>
                </rule>
                <rule name="Block Bad Bots" enabled="true" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAny" trackAllCaptures="false">
                        <add input="{HTTP_USER_AGENT}" pattern=".*seokicks.*" />
                        <add input="{HTTP_USER_AGENT}" pattern=".*petalsearch.*" />
                        <add input="{HTTP_USER_AGENT}" pattern=".*SeekportBot.*" />
                        <add input="{HTTP_USER_AGENT}" pattern=".*webmeup-crawler.*" />
                    </conditions>
                    <action type="CustomResponse" statusCode="401" subStatusCode="555"
                        statusReason="Access denied: crawler denied"
                        statusDescription="IP Restriction: the crawler name is included in the deny list (robots.txt ignored)" />
                </rule>
                <rule name="Webtrees .git etc" enabled="true" stopProcessing="true">
                    <match url="^\." ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="CustomResponse" statusCode="403"
                        statusReason="Forbidden - internal config" statusDescription="Forbidden" />
                </rule>
                <rule name="Webtrees data" enabled="true">
                    <match url="^data(/|$)" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden"
                        statusDescription="Forbidden" />
                </rule>
                <rule name="Webtrees app" enabled="true">
                    <match url="^app(/|$)" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden"
                        statusDescription="Forbidden" />
                </rule>
                <rule name="Webtrees modules" enabled="true">
                    <match url="^modules" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden"
                        statusDescription="Forbidden" />
                </rule>
                <rule name="Webtrees resources" enabled="true">
                    <match url="^resources(/|$)" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden"
                        statusDescription="Forbidden" />
                </rule>
                <rule name="Webtrees vendor" enabled="true">
                    <match url="^vendor(/|$)" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden"
                        statusDescription="Forbidden" />
                </rule>
                <rule name="webtrees route= &amp;" enabled="false" stopProcessing="true">
                    <match url="index\.php?" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{QUERY_STRING}" pattern="route=(%2F|/)(.*)&amp;(.*)" />
                    </conditions>
                    <action type="Redirect" url="/{C:2}?{C:3}" appendQueryString="false" />
                </rule>
                <rule name="Webtrees route=" enabled="false" stopProcessing="true">
                    <match url="index\.php?" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAny" trackAllCaptures="false">
                        <add input="{QUERY_STRING}" pattern="route=(%2F|/)(.*)" ignoreCase="false" />
                    </conditions>
                    <action type="Redirect" url="/{C:2}" appendQueryString="false"
                        logRewrittenUrl="true" />
                </rule>
                <rule name="Webtrees Rewrite" enabled="true" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" appendQueryString="true"
                        logRewrittenUrl="false" />
                    <serverVariables>
                        <set name="REQUEST_URI" value="{UNENCODED_URL}" />
                    </serverVariables>
                </rule>
            </rules>
            <outboundRules>
                <!-- Outbound Rule OSM: User-Agent setzen -->

                <preConditions>
                    <preCondition name="Always">
                        <add input="{CACHE_URL}" pattern=".*" />
                    </preCondition>
                </preConditions>
            </outboundRules>
        </rewrite>
        <security>
            <requestFiltering>
                <requestLimits maxUrl="20480" maxQueryString="20480" />
            </requestFiltering>
        </security>
        <caching enabled="true" enableKernelCache="true" maxCacheSize="1000"
            maxResponseSize="512000">
            <profiles>
            </profiles>
        </caching>
        <httpProtocol allowKeepAlive="true">
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Powered-By" value="PHP/8.5+" />
            </customHeaders>
        </httpProtocol>
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
        </staticContent>
    </system.webServer>
</configuration>